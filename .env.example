# Copy this file to .env and set the value locally. Never commit the real key.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional override:
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-lite-latest:generateContent

# Optional OpenAI-compatible provider. If both providers are configured, this takes precedence.
# INTERVEXA_AI_API_URL=
# INTERVEXA_AI_API_KEY=
# INTERVEXA_AI_MODEL=gpt-4o-mini

# Authentication
# Use a long random value in production. Sessions are invalidated if this changes.
INTERVEXA_SECRET_KEY=replace_with_a_long_random_session_secret
# Set true only when the app is served over HTTPS.
INTERVEXA_SESSION_COOKIE_SECURE=false
# Comma-separated exact browser origins allowed to send credentialed requests.
INTERVEXA_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000
# Optional custom database path:
# INTERVEXA_AUTH_DB_PATH=D:\PYTHON\Intervexa AI\backend\data\intervexa.db
# Password reset delivery is not configured in this project. Keep false in production.
AUTH_EXPOSE_RESET_TOKEN=false
